<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" /></Style>
    <Style TargetType="Label"><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="TextColor" Value="{StaticResource MainText}" /></Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource MainText}" /><Setter Property="PlaceholderColor" Value="{StaticResource SubtleText}" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="{StaticResource MainText}" /><Setter Property="PlaceholderColor" Value="{StaticResource SubtleText}" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="FontSize" Value="15" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource MainText}" /><Setter Property="TitleColor" Value="{StaticResource SubtleText}" /><Setter Property="BackgroundColor" Value="Transparent" /></Style>
    <Style TargetType="DatePicker"><Setter Property="TextColor" Value="{StaticResource MainText}" /><Setter Property="BackgroundColor" Value="Transparent" /></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="CornerRadius" Value="12" /><Setter Property="HeightRequest" Value="50" /></Style>

    <Style x:Key="HeroTitle" TargetType="Label"><Setter Property="TextColor" Value="White" /><Setter Property="FontSize" Value="30" /><Setter Property="FontAttributes" Value="Bold" /></Style>
    <Style x:Key="CardTitle" TargetType="Label"><Setter Property="FontSize" Value="17" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="TextColor" Value="{StaticResource MainText}" /></Style>
    <Style x:Key="MutedText" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="{StaticResource MutedText}" /><Setter Property="LineHeight" Value="1.2" /></Style>
    <Style x:Key="FieldCaption" TargetType="Label"><Setter Property="FontSize" Value="11" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="TextColor" Value="{StaticResource MutedText}" /><Setter Property="CharacterSpacing" Value="1" /></Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" /><Setter Property="Stroke" Value="{StaticResource BorderColor}" /><Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="17" /><Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Shadow"><Setter.Value><Shadow Brush="#140E1648" Offset="0,4" Radius="12" Opacity="0.35" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="18" /><Setter Property="MinimumHeightRequest" Value="130" /></Style>
    <Style x:Key="InputBorder" TargetType="Border"><Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="{StaticResource BorderColor}" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="Padding" Value="13,3" /><Setter Property="StrokeShape" Value="RoundRectangle 12" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
    <Style x:Key="EmptyIcon" TargetType="Border"><Setter Property="WidthRequest" Value="66" /><Setter Property="HeightRequest" Value="66" /><Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="Padding" Value="10" /><Setter Property="StrokeShape" Value="RoundRectangle 33" /></Style>

    <Style x:Key="HeaderButton" TargetType="Button"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="{StaticResource Primary}" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="15,8" /><Setter Property="HeightRequest" Value="44" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Primary}" /><Setter Property="TextColor" Value="White" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
    <Style x:Key="DangerButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" /><Setter Property="TextColor" Value="{StaticResource Danger}" /><Setter Property="BorderColor" Value="#FFD0D3" /><Setter Property="BorderWidth" Value="1" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="MinimumHeightRequest" Value="52" /></Style>
</ResourceDictionary>
