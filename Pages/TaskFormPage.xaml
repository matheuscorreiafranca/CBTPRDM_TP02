<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.Pages.TaskFormPage" BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancelar" Clicked="OnCancelClicked" Order="Primary" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="22,24,22,34" Spacing="19" MaximumWidthRequest="680" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="5">
                <Label x:Name="HeadingLabel" Text="Nova tarefa" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource MainText}" />
                <Label x:Name="SubtitleLabel" Text="Preencha os dados para organizar sua rotina." Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="7">
                <Label Text="TÍTULO" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry x:Name="TitleEntry" Placeholder="Ex.: Entregar atividade" ReturnType="Next" Completed="OnTitleCompleted" MaxLength="80" ClearButtonVisibility="WhileEditing" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="7">
                <Label Text="DESCRIÇÃO" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}" Padding="13,9">
                    <Editor x:Name="DescriptionEditor" Placeholder="Inclua os detalhes importantes..." AutoSize="TextChanges" MinimumHeightRequest="112" MaxLength="300" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="7">
                    <Label Text="DATA DE CRIAÇÃO" Style="{StaticResource FieldCaption}" />
                    <Border Style="{StaticResource InputBorder}"><DatePicker x:Name="CreatedAtPicker" Format="dd/MM/yyyy" /></Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="7">
                    <Label Text="PRIORIDADE" Style="{StaticResource FieldCaption}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Picker x:Name="PriorityPicker" Title="Selecione" SelectedIndex="1">
                            <x:String>Baixa</x:String><x:String>Média</x:String><x:String>Alta</x:String>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Border x:Name="ErrorPanel" IsVisible="False" BackgroundColor="#FFF0F1" Stroke="#FFD0D3" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 10">
                <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontSize="13" />
            </Border>
            <Button x:Name="SaveButton" Text="Salvar tarefa" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
